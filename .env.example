# Copy to .env and fill in. Never commit .env (see .gitignore).
# Every key below is documented here so a fresh clone knows what is required.

# --- Database (Phase 1+) ---
# Port 55432 is the host side of docker-compose's postgres mapping; the container itself
# still listens on 5432. 5432/5433 are avoided because a native Postgres usually owns
# 5432 and Windows reserves 5433-5532. Change here and in docker-compose.yml together.
DATABASE_URL=postgresql+psycopg://app:app@localhost:55432/football

# --- Vector store (Phase 7+) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM (Phase 3+) ---
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=10
MAX_CRITIC_RETRIES=2

# --- Observability (Phase 11) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# --- Application ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local
LOG_LEVEL=INFO
# How long /health waits for a database ping before reporting "unavailable".
DB_HEALTH_TIMEOUT_SECONDS=2

# --- Frontend (put these in frontend/.env, Vite only reads that file) ---
# VITE_API_URL=http://localhost:8000
