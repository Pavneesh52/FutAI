{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Football Match Analyst",
    "summary": "Ask questions about a football match; every number traces to a tool call.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness check plus dependency status",
        "description": "Report whether the API is up, and whether its database is reachable.\n\nAlways returns HTTP 200 while the process is serving: a database that is down or\nnot yet configured is reported in the body (rule R5 -- degrade, don't crash).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/matches": {
      "get": {
        "tags": ["matches"],
        "summary": "List matches",
        "description": "All ingested matches, most recent first.",
        "operationId": "list_matches_matches_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MatchSummary"
                  },
                  "type": "array",
                  "title": "Response List Matches Matches Get"
                }
              }
            }
          }
        }
      }
    },
    "/matches/{match_id}": {
      "get": {
        "tags": ["matches"],
        "summary": "One match",
        "description": "A match with the counts that tell you what data exists for it.",
        "operationId": "get_match_matches__match_id__get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Match Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/matches/{match_id}/events": {
      "get": {
        "tags": ["matches"],
        "summary": "A match's events",
        "description": "Events in match order, optionally filtered by normalised type.",
        "operationId": "get_events_matches__match_id__events_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Match Id"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Normalised event type, e.g. `shot`, `pass`, `tackle`.",
              "title": "Event Type"
            },
            "description": "Normalised event type, e.g. `shot`, `pass`, `tackle`."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchEvent"
                  },
                  "title": "Response Get Events Matches  Match Id  Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/matches/{match_id}/players": {
      "get": {
        "tags": ["matches"],
        "summary": "Per-player aggregates for a match",
        "description": "Per-player aggregates, most minutes first. Unused substitutes appear with 0 minutes.",
        "operationId": "get_players_matches__match_id__players_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Match Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlayerMatchStats"
                  },
                  "title": "Response Get Players Matches  Match Id  Players Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/matches/{match_id}/stats": {
      "get": {
        "tags": ["matches"],
        "summary": "Per-team match statistics",
        "description": "Per-team match aggregates (possession %, xG, PPDA, field tilt, shots, passes).",
        "operationId": "get_team_stats_matches__match_id__stats_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Match Id"
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by team id; if omitted, returns both teams.",
              "title": "Team Id"
            },
            "description": "Filter by team id; if omitted, returns both teams."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamMatchStats"
                  },
                  "title": "Response Get Team Stats Matches  Match Id  Stats Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analysis": {
      "post": {
        "tags": ["analysis"],
        "summary": "Analyze Query",
        "description": "Analyze a football question using deterministic tools and Grok.",
        "operationId": "analyze_query_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "match_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Id"
          }
        },
        "type": "object",
        "required": ["query"],
        "title": "AnalysisRequest",
        "description": "Payload for POST /analysis."
      },
      "AnalysisResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "query_type": {
            "type": "string",
            "enum": ["simple_stat", "player", "tactical", "comparison", "report"],
            "title": "Query Type"
          },
          "answer_markdown": {
            "type": "string",
            "title": "Answer Markdown"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceItem"
            },
            "type": "array",
            "title": "Sources"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 1.0
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "default": false
          },
          "retry_count": {
            "type": "integer",
            "title": "Retry Count",
            "default": 0
          }
        },
        "type": "object",
        "required": ["run_id", "query_type", "answer_markdown"],
        "title": "AnalysisResult",
        "description": "Response contract for POST /analysis and base for specialized queries."
      },
      "EvidenceItem": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": ["ref", "label"],
        "title": "EvidenceItem",
        "description": "One resolved evidence_ref, rendered in the UI's Evidence list."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"],
            "title": "Status",
            "description": "`degraded` when a required dependency is unreachable; the process is still serving."
          },
          "db": {
            "type": "string",
            "enum": ["ok", "unavailable", "not_configured"],
            "title": "Db",
            "description": "Database probe result: `ok`, `unavailable`, or `not_configured`."
          }
        },
        "type": "object",
        "required": ["status", "db"],
        "title": "HealthResponse",
        "description": "Result of `GET /health`."
      },
      "MatchDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "home_team": {
            "$ref": "#/components/schemas/TeamSummary"
          },
          "away_team": {
            "$ref": "#/components/schemas/TeamSummary"
          },
          "competition": {
            "type": "string",
            "title": "Competition"
          },
          "season": {
            "type": "string",
            "title": "Season"
          },
          "match_date": {
            "type": "string",
            "format": "date",
            "title": "Match Date"
          },
          "home_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Score",
            "description": "NULL if not played in the source."
          },
          "away_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Away Score"
          },
          "event_count": {
            "type": "integer",
            "title": "Event Count",
            "description": "Number of ingested events."
          },
          "has_stats": {
            "type": "boolean",
            "title": "Has Stats",
            "description": "True once team_match_stats rows exist for this match."
          }
        },
        "type": "object",
        "required": [
          "id",
          "home_team",
          "away_team",
          "competition",
          "season",
          "match_date",
          "event_count",
          "has_stats"
        ],
        "title": "MatchDetail",
        "description": "`GET /matches/{id}`: a summary plus what the match actually contains."
      },
      "MatchEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "match_id": {
            "type": "integer",
            "title": "Match Id"
          },
          "minute": {
            "type": "integer",
            "title": "Minute"
          },
          "second": {
            "type": "integer",
            "title": "Second"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "team_id": {
            "type": "integer",
            "title": "Team Id"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          },
          "x": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "X"
          },
          "y": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "xg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Xg"
          },
          "related_event_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Related Event Id"
          },
          "possession_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Possession Id"
          }
        },
        "type": "object",
        "required": ["id", "match_id", "minute", "second", "event_type", "team_id"],
        "title": "MatchEvent",
        "description": "A single event, with our own surrogate `id` (the source id is a UUID)."
      },
      "MatchSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "home_team": {
            "$ref": "#/components/schemas/TeamSummary"
          },
          "away_team": {
            "$ref": "#/components/schemas/TeamSummary"
          },
          "competition": {
            "type": "string",
            "title": "Competition"
          },
          "season": {
            "type": "string",
            "title": "Season"
          },
          "match_date": {
            "type": "string",
            "format": "date",
            "title": "Match Date"
          },
          "home_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Score",
            "description": "NULL if not played in the source."
          },
          "away_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Away Score"
          }
        },
        "type": "object",
        "required": ["id", "home_team", "away_team", "competition", "season", "match_date"],
        "title": "MatchSummary",
        "description": "One row of `GET /matches`."
      },
      "PlayerMatchStats": {
        "properties": {
          "match_id": {
            "type": "integer",
            "title": "Match Id"
          },
          "player_id": {
            "type": "integer",
            "title": "Player Id"
          },
          "player_name": {
            "type": "string",
            "title": "Player Name"
          },
          "team_id": {
            "type": "integer",
            "title": "Team Id"
          },
          "minutes_played": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minutes Played"
          },
          "goals": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goals"
          },
          "assists": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assists"
          },
          "xg": {
            "anyOf": [
              {
