            "title": "Xa"
          },
          "passes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passes"
          },
          "pass_accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pass Accuracy"
          },
          "shots": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shots"
          },
          "tackles": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tackles"
          },
          "position_played": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position Played"
          }
        },
        "type": "object",
        "required": ["match_id", "player_id", "player_name", "team_id"],
        "title": "PlayerMatchStats",
        "description": "Aggregated player performance in one match."
      },
      "SourceItem": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": ["title", "url"],
        "title": "SourceItem",
        "description": "RAG citations only (Phase 7)."
      },
      "TeamMatchStats": {
        "properties": {
          "match_id": {
            "type": "integer",
            "title": "Match Id"
          },
